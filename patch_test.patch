+fn sort_tree_items(items: &mut Vec<TreeItem>) {
+    items.sort_by(|a, b| {
+        if a.is_dir == b.is_dir {
+            a.name.cmp(&b.name)
+        } else if a.is_dir {
+            std::cmp::Ordering::Less
+        } else {
+            std::cmp::Ordering::Greater
+        }
+    });
+}
+
+fn sort_tree_dir_items(dirs: &mut Vec<TreeDirItem>) {
+    dirs.sort_by(|a, b| a.name.cmp(&b.name));
+}
